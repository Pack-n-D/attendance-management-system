# AP Corporation (APC) Attendance Management Platform
# Mobile Application Environment Variables

# The backend API URL (Defaults to production Railway backend)
# For production deployment:
EXPO_PUBLIC_API_URL=https://web-production-f5d6b.up.railway.app/api

# For local development with backend running on host:
# Android Emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api
# iOS Simulator / Web:
# EXPO_PUBLIC_API_URL=http://localhost:5000/api
# Physical Device over Local Wi-Fi:
# EXPO_PUBLIC_API_URL=http://<YOUR_LAN_IP>:5000/api
